# Puerto del servidor Express
PORT=4000

# Conexión a la base de datos PostgreSQL / Supabase (Prisma)
# Si usas Supabase Connection Pooling (puerto 6543 para DATABASE_URL y 5432 para DIRECT_URL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Clave secreta para firma y verificación de tokens JWT (mínimo 32 caracteres)
JWT_SECRET="icpc_grind_super_secret_jwt_key_2026_production"

# Tiempo de expiración del token JWT
JWT_EXPIRES_IN="7d"

# Origen permitido para CORS (Frontend Next.js)
CORS_ORIGIN="http://localhost:3000"
